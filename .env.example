# Streamable HTTP MCP (order / inventory backend)
MCP_SERVER_URL=https://order-mcp-74afyau24q-uc.a.run.app/mcp

# Required for the OpenAI Agents sign-in assistant
OPENAI_API_KEY=

# Optional: override auth agent model (default gpt-4o-mini)
# OPENAI_MERIDIAN_AUTH_MODEL=gpt-4o-mini

# Logging: INFO | DEBUG | WARNING … and text | json (one JSON object per line)
# MERIDIAN_LOG_LEVEL=INFO
# MERIDIAN_LOG_FORMAT=text

# Off by default: when true, a chat line ORDER_SUBMIT: [{"sku":"MON-0080","quantity":1,...}]
# triggers a real create_order MCP call for the signed-in customer.
# MERIDIAN_ENABLE_ORDER_SUBMIT=false